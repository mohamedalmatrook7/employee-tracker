# Copy this file to .env.local and fill in your Supabase project values.
#
# ── Local Supabase (supabase start) ────────────────────────────────
# The CLI prints these when you run `supabase start`. Typical defaults:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key printed by supabase start>
#
# ── Hosted Supabase ────────────────────────────────────────────────
# Project Settings → API:
#   NEXT_PUBLIC_SUPABASE_URL   = Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = anon / public key
#
# On Vercel, add these two vars in the project settings, then locally run
#   vercel env pull .env.local
# to sync them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
